{
  "name": "starforge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static site for Starforge: landing page, documentation, and trace format reference.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:offline": "node build.mjs --diagrams=off",
    "sync-docs": "node scripts/sync-docs.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test test/*.test.mjs",
    "test:diagrams": "STARFORGE_DIAGRAMS=1 node --test test/build.test.mjs",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "marked": "^18.1.3",
    "marked-gfm-heading-id": "^4.1.4",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.1"
  }
}
